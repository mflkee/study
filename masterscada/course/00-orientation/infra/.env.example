# Скопируй в .env и поправь под себя. Файл .env читается docker compose автоматически
# и в git не коммитится (см. .gitignore в корне репозитория).

# Адрес публикации порта: 127.0.0.1 — только локально (безопасный дефолт);
# 0.0.0.0 — если к БД должна ходить RT-машина по сети (осознанное решение!).
PG_BIND=127.0.0.1

# Второй адрес публикации — для среды разработки в VM (Astra в KVM):
# гость видит хост как шлюз моста virbr0. Пусто/закомментируй строку в compose,
# если VM на машине нет. Остальное (домен, отдельная машина) см. README.
PG_BIND_VM=192.168.122.1

# Порт на хосте. 15444 — чтобы не конфликтовать с системным PostgreSQL (5432).
PG_PORT=15444

# Доступы к стенду (их же вписываем в настройки среды разработки).
PG_USER=course
PG_PASSWORD=course
PG_DB=course

# Часовой пояс контейнера (важен для времени в архивах, модуль 07).
TZ=Europe/Moscow

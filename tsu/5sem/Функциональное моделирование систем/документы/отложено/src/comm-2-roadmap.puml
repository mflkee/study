@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam object {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
}
object ":ЭкранКарты" as UI
object ":СервисКарты" as SVC
object ":РепозиторийПатентов" as REPO
object "патент : Патент" as PAT
object "пункт : ПунктКарты" as PT1
object "пункт : ПунктКарты" as PT2

UI -down-> SVC : 1
SVC -down-> REPO : 2
REPO -up-> SVC : 3
SVC -down-> PAT : 4
SVC -right-> PT1 : 5
SVC -right-> PT2 : 6
SVC -up-> UI : 7
@enduml

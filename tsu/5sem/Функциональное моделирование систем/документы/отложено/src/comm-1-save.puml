@startuml
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 16
skinparam shadowing false
skinparam object {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
}
object ":ЭкранАнкеты" as UI
object ":СервисАнкет" as SVC
object "патент : Патент" as PAT
object "договор : Договор" as DOG
object ":РепозиторийПатентов" as REPO

UI -down-> SVC : 1
SVC -down-> PAT : 2
SVC -down-> DOG : 3
PAT -right-> DOG : 4
SVC -down-> REPO : 5
SVC -up-> UI : 6
@enduml

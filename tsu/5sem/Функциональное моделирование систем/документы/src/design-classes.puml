@startuml class-diagram
' Лаб. 5: классы проектирования. Согласовано с диаграммами коммуникаций лабы 4.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 16
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 45
skinparam class {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
}
skinparam ArrowColor #333333

package "Граница" {
  class ЭкранАнкеты <<boundary>> {
    + сохранитьАнкету(данные)
  }
  class ЭкранКарты <<boundary>> {
    + показатьКарту(пункты)
  }
}

package "Управление" {
  class СервисАнкет <<control>> {
    + сохранитьАнкету(данные) : Патент
  }
  class СервисКарты <<control>> {
    + построитьКарту(патент) : ПунктКарты
  }
}

package "Сущности" {
  class ИностранныйГражданин {
    фио
    гражданство
    паспорт
    телефон
  }
  class Патент {
    серия
    номер
    датаВыдачи
    регион
    профессия
  }
  class Договор {
    вид
    датаЗаключения
  }
  class ПунктКарты {
    вид
    плановаяДата
  }
}

package "Хранилище" {
  class РепозиторийПатентов <<repository>> {
    + найтиПатент(серия, номер) : Патент
    + сохранить(патент)
  }
}

ЭкранАнкеты --> СервисАнкет
ЭкранКарты --> СервисКарты
СервисАнкет --> Патент
СервисАнкет --> Договор
СервисАнкет --> РепозиторийПатентов
СервисКарты --> ПунктКарты
СервисКарты --> РепозиторийПатентов
Патент --> Договор
@enduml

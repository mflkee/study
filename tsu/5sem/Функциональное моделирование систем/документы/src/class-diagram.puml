@startuml class-diagram
' Лаб. 2: модель предметной области темы 7 (пункты 7.1 и 7.2).
' Только атрибуты; без id, методов и модификаторов доступа.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
}
skinparam ArrowColor #333333

class ИностранныйГражданин {
  фио
  гражданство
  паспорт
  телефон
}

class Патент {
  серия
  номер
  датаВыдачи
  регион
  профессия
  статус
}

class Работодатель {
  наименование
  инн
}

abstract class Договор {
  номер
  датаЗаключения
  статус
}
class ТрудовойДоговор {
  должность
}
class ДоговорГПХ {
  предмет
}
Договор <|-- ТрудовойДоговор
Договор <|-- ДоговорГПХ

class ПунктКарты {
  вид
  плановаяДата
  статус
}

ИностранныйГражданин "1" --> "0..*" Патент : имеет
Патент "1" --> "0..1" Договор : действующий договор
Работодатель "1" --> "0..*" Договор : заключает
Патент "1" *-- "0..*" ПунктКарты : сроки
@enduml

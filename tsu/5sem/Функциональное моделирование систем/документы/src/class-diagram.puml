@startuml class-diagram
' Лаб. 2: модель предметной области. Четыре класса, только то, что нужно сценариям лабы 1.
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
}
skinparam ArrowColor #333333

class ИностранныйГражданин

class Патент {
  серия
  номер
  датаВыдачи
  регион
  профессия
}

class Договор {
  вид
  датаЗаключения
}

class ПунктКарты {
  вид
  плановаяДата
}

ИностранныйГражданин "1" --> "0..*" Патент : имеет
Патент "1" --> "0..*" Договор : договоры
Патент "1" *-- "0..*" ПунктКарты : сроки
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 16
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
hide footbox
actor "Иностранный гражданин" as IG
participant "Система" as SYS
IG -> SYS : запроситьДорожнуюКарту()
SYS --> IG : пункт «Трудоустройство»:\nдоговор от <дата>, срок соблюдён
SYS --> IG : пункт «Уведомление МВД»:\nнаправить уведомление\nне позднее того же срока
@enduml

@startuml
' Упрощённая системная диаграмма последовательностей (SSD, «чёрный ящик») для книжки
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam defaultFontSize 20
skinparam sequenceMessageAlign left
skinparam maxMessageSize 300
skinparam ParticipantBackgroundColor #F4F8FF
skinparam ParticipantBorderColor #4A6FA5
skinparam ArrowColor #333333
skinparam NoteBackgroundColor #FFFDF0
skinparam NoteBorderColor #C9B458
hide footbox

actor "Иностранный\nгражданин" as IG
participant "Система «Действия\nпосле получения патента»" as SYS

IG -> SYS : 1. зарегистрироватьПатент(данные патента, скан)
note over SYS
  Проверка: другого действующего патента нет (ИНВ-5);
  обязательные поля и справочники Регион, ВидДеятельности.
  Расчёт: «трудоустроиться не позднее» = дата выдачи + 2 месяца (ИНВ-3).
  Создаются контрольные точки «заключить договор»
  и «направить уведомление» (ИНВ-6).
end note
SYS --> IG : 2. патент учтён, сроки рассчитаны
@enduml

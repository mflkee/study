@startuml
' Ядро модели предметной области — только связи, важные для темы 7
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam defaultFontSize 26
skinparam classAttributeIconSize 0
skinparam ArrowColor #333333
skinparam class {
  BackgroundColor #F7FBFF
  BorderColor #4A6FA5
}
skinparam note {
  BackgroundColor #FFFDF0
  BorderColor #C9B458
}

class "Иностранный\nгражданин" as IG {
  фио
  гражданство
  телефон
}
class "Патент" as PAT {
  серия, номер
  дата выдачи
  срок действия
}
class "Договор" as DOG {
  номер
  вид
  дата заключения
}
class "Уведомление\nМВД" as UVD {
  канал
  дата направления
  номер квитанции
}
class "Работодатель" as RAB {
  наименование
  ИНН
}

IG "1" --> "0..*" PAT : имеет
PAT "1" --> "0..1" DOG : действующий договор
DOG "1" --> "0..1" UVD : по договору
RAB "1" --> "0..*" DOG : заключает

note bottom of DOG
  1 — ровно один объект;
  0..1 — не более одного (может не быть);
  0..* — сколько угодно, включая ноль.
end note
@enduml

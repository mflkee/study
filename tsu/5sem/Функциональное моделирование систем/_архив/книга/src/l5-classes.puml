@startuml
' Классы проектирования: обзор слоёв BCE (лаб. 5)
' 26 классов: 4 boundary + 4 control + 13 entity + 3 repository + 2 gateway (DESIGN.md §6).
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam defaultFontSize 17
skinparam nodesep 10
skinparam ranksep 22
skinparam ArrowColor #333333
skinparam package {
  BackgroundColor #F4F7FB
  BorderColor #6B7C93
  FontStyle bold
}
skinparam class {
  BackgroundColor #F4F8FF
  BorderColor #4A6FA5
}
hide empty members
hide circle
skinparam classAttributeIconSize 0

package "boundary — 4" as P_UI {
  class "ЭкранПатента" as B1
  class "ЭкранДоговора" as B2
  class "ЭкранУведомления" as B3
  class "ЭкранСроков" as B4
}

package "control — 4" as P_CTL {
  class "СервисПатентов" as C1
  class "СервисДоговоров" as C2
  class "СервисУведомлений" as C3
  class "СервисСроков" as C4
}

package "entity — 13" as P_ENT {
  class "ИностранныйГражданин" as E1
  class "Патент" as E2
  class "Регион" as E3
  class "ВидДеятельности" as E4
  class "Работодатель" as E5
  class "Договор" as E6
  class "ТрудовойДоговор" as E7
  class "ДоговорГПХ" as E8
  class "УведомлениеМВД" as E9
  class "КонтрольнаяТочка" as E10
  class "Напоминание" as E11
  class "Документ" as E12
  class "ТерриториальныйОрганМВД" as E13
}

package "repository — 3" as P_REP {
  class "РепозиторийПатентов" as R1
  class "РепозиторийДоговоров" as R2
  class "РепозиторийУведомлений" as R3
}

package "gateway — 2" as P_GW {
  class "ШлюзЕПГУ" as G1
  class "ШлюзПочты" as G2
}
@enduml

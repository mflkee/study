@startuml
' Упрощённая системная диаграмма последовательностей (SSD, «чёрный ящик») для книжки
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam defaultFontSize 20
skinparam sequenceMessageAlign left
skinparam maxMessageSize 300
skinparam ParticipantBackgroundColor #F4F8FF
skinparam ParticipantBorderColor #4A6FA5
skinparam ArrowColor #333333
skinparam NoteBackgroundColor #FFFDF0
skinparam NoteBorderColor #C9B458
hide footbox

actor "Иностранный\nгражданин" as IG
participant "Система «Действия\nпосле получения патента»" as SYS

IG -> SYS : 1. получитьСведенияОпатенте(серия, номер)
SYS --> IG : 2. срок действия, регион, профессия
IG -> SYS : 3. заключитьДоговор(данные договора, файл)
note over SYS
  Проверки: другого действующего договора нет (ИНВ-1);
  договор не позднее 2 месяцев с даты выдачи патента (ИНВ-3);
  профессия входит в указанные в патенте (ИНВ-4).
  Создаётся контрольная точка «направить уведомление МВД».
end note
SYS --> IG : 4. договор заключён
@enduml
